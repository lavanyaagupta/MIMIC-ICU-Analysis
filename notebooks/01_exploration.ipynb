# filter chartevents to only itemids
vitals_subset = vitals[vitals['itemid'].isin(all_itemids)].copy()
vitals_subset['vital'] = vitals_subset['itemid'].map(itemid_to_vital)   # <-- this line was missing
print(len(vitals_subset))

# bring in icustay_ids in time from cohort table
df['survived'] = 1 - df['hospital_expire_flag'] # make column for surviving patients
cohort_times = df[['subject_id','hadm_id','icustay_id','intime','survived']].copy()
cohort_times['intime'] = pd.to_datetime(cohort_times['intime'])

vitals_subset = vitals_subset.merge(
    cohort_times, on = ['subject_id','hadm_id','icustay_id'],
    how = 'inner')

print(len(vitals_subset)) #checking to see how many rows were dropped with merge

# now restricting to the first 24hr window since admission
vitals_subset['charttime'] = pd.to_datetime(vitals_subset['charttime'])
vitals_subset['hours_since_admission'] = (
    (vitals_subset['charttime'] - vitals_subset['intime']).dt.total_seconds() / 3600)

vitals_24h = vitals_subset[
    (vitals_subset['hours_since_admission'] >= 0) &
    (vitals_subset['hours_since_admission'] <= 24)
].copy()

vitals_24h.head(10)

print(vitals_24h['vital'].value_counts())
print(vitals_24h['valuenum'].isna().sum(), "rows with null valuenum")
print(vitals_24h.groupby('vital')['valueuom'].unique())

# dropping rows with no numeric value
vitals_clean = vitals_24h[vitals_24h['valuenum'].notna()].copy()
print(len(vitals_24h) - len(vitals_clean))

# drop warning/error flagged rows if present
if 'error' in vitals_clean.columns:
    vitals_clean = vitals_clean[vitals_clean['error'] != 1]

# apply physiologically plausible ranges per vital
plausible_ranges = {
    'heart_rate': (20, 300),
    'resp_rate': (0, 70),
    'temperature_c': (25, 44),   # excludes anything logged in F by mistake
    'spo2': (0, 100),
    'sbp': (20, 300),
    'dbp': (10, 250),
}

def in_range(row):
    lo, hi = plausible_ranges[row['vital']]
    return lo <= row['valuenum'] <= hi

before = len(vitals_clean)
vitals_clean = vitals_clean[vitals_clean.apply(in_range, axis=1)]
print(before - len(vitals_clean))

# handle duplicate readings at the same patient/time/vital
# if carevue and metavision both logged a reading in the same minute (rare edge case) or duplicate row, average instead of double counting

vitals_clean = (
    vitals_clean
    .groupby(['subject_id','hadm_id','icustay_id','vital','charttime','survived'], as_index = False)
    .agg({'valuenum': 'mean', 'hours_since_admission': 'first'}))
print(len(vitals_clean))
vitals_clean.head()

# bin into hourly intervals, looking for a 0-23 hour bucket
vitals_clean['hour'] = vitals_clean['hours_since_admission'].apply(lambda h: int(h))

hourly = (
    vitals_clean
    .groupby(['icustay_id','vital','hour','survived'], as_index=False)
    ['valuenum'].mean())

print(hourly.shape)
hourly.head()

# aggregate across patients by outcome group
# for each vital/hour/survived combo, average across all patients in that group

trend = (
    hourly
    .groupby(['vital','hour','survived'], as_index=False)
    ['valuenum'].mean())

trend.head()

# plot each vital, survivors vs. non-survivors
import matplotlib.pyplot as plt

vitals_list = trend['vital'].unique()

fig, axes = plt.subplots(len(vitals_list), 1, figsize=(8, 4 * len(vitals_list)))

for ax, vital in zip(axes, vitals_list):
    subset = trend[trend['vital'] == vital]
    for outcome, label, color in [(1, 'Survived', 'tab:blue'), (0, 'Did not survive', 'tab:red')]:
        line = subset[subset['survived'] == outcome].sort_values('hour')
        ax.plot(line['hour'], line['valuenum'], label=label, color=color, marker='o', markersize=3)
    ax.set_title(vital)
    ax.set_xlabel('Hours since ICU admission')
    ax.set_ylabel('Mean value')
    ax.legend()
    ax.grid(alpha=0.3)

plt.tight_layout()
plt.show()
